# Copiar a .env y llenar valores reales. .env NUNCA se versiona.

# MySQL
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# PostgreSQL (Sofia)
PG_USER=
PG_PASSWORD=
PG_HOST=
PG_PORT=
PG_NAME=

# Banxico SIE (tipo de cambio USD/MXN, serie SF43718) — modulo Rastreo de Importaciones
# 1. Entra a https://www.banxico.org.mx/SieAPIRest/service/v1/ y registrate gratis.
# 2. Banxico te manda el token por correo.
# 3. Pega el token aqui, sin comillas.
BANXICO_API_TOKEN= token

# API key server-to-server para las notificaciones de escalacion de Sofia.
# La usa n8n en el header X-API-Key al pegar en POST /notificaciones/escalacion.
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Skydropx Pro — modulo de envios (cotizacion, guias y rastreo)
# ─────────────────────────────────────────────────────────────────────────────
# Credenciales OAuth (client_credentials). Salen del panel de Skydropx Pro >
# Configuracion > API. Si se dejan vacias, el servicio cae a SKYDROP_API_KEY y
# SKYDROP_API_SECRET, que es donde estaban capturadas antes de este modulo.
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=

# Ambiente. Sandbox no genera guias reales ni cobra:
#   sandbox    -> https://sb-pro.skydropx.com
#   produccion -> https://pro.skydropx.com
SKYDROPX_BASE_URL=https://sb-pro.skydropx.com

# Secreto del webhook de estatus. Sin esto, POST /skydropx/webhook responde 503
# y no acepta ningun evento. Se define al dar de alta el webhook en Skydropx.
SKYDROPX_WEBHOOK_SECRET=

# Cabecera donde llega la firma HMAC-SHA512 del webhook. Solo cambiar si Skydropx
# la manda con otro nombre. Por defecto: X-Skydropx-Signature
SKYDROPX_WEBHOOK_HEADER=

# ─────────────────────────────────────────────────────────────────────────────
# Amazon SP-API — job de ventas (migración del workflow n8n `ventas_amazon`)
# Apaga el workflow en n8n (active:false) antes de probar el job.
# ─────────────────────────────────────────────────────────────────────────────
# LWA (https://developer-docs.amazon.com/sp-api): app privada, rol Selling Partner.
AMZ_CLIENT_ID=
AMZ_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_MARKETPLACE_ID=A1AM78C64UM0Y8
# Scheduler diario (hora CDMX). 1 = activo, 0 = solo disparo manual.
AMAZON_JOB_ENABLED=1
AMAZON_JOB_HORA=12:22
# 1 = corre todo pero no escribe en DB (para probar hoy sin riesgo).
AMAZON_JOB_DRY_RUN=1

# ─────────────────────────────────────────────────────────────────────────────
# MeLi + MercadoPago — job de ventas (migración del workflow n8n MeLi)
# Apaga el workflow en n8n antes de probar el job. OAuth con refresh
# automático en cada run (misma cuenta que el credential "MELI cuenta").
# ─────────────────────────────────────────────────────────────────────────────
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REFRESH_TOKEN=
# Scheduler diario (hora CDMX). 1 = activo, 0 = solo disparo manual.
MELI_JOB_ENABLED=1
MELI_JOB_HORA=12:05
# 1 = corre todo pero no escribe en DB (para probar sin riesgo).
MELI_JOB_DRY_RUN=1
# Chat de alertas (margen, sin costo, errores). Grupo por defecto en TELEGRAM_GROUP_ID.
MELI_ALERT_CHAT_ID=630880920
# Secreto para verificar x-signature de MercadoPago. Sale del dashboard de MP.
# Vacío = no se verifica firma (igual se valida todo por GET del recurso).
MELI_WEBHOOK_SECRET=
# Redirect URI registrado en la app MeLi (debe ser idéntico al de autorización).
# Ej: https://tu-dominio/zeutica/meli/oauth/callback
MELI_REDIRECT_URI=
# Job stock MeLi (publica bodega a publicaciones, 20:00 CDMX).
MELI_STOCK_ENABLED=1
MELI_STOCK_HORA=20:00
MELI_STOCK_DRY_RUN=0
# Job recordatorios Cleanest (órdenes próximas a vencer, 11:00 CDMX).
CLEANEST_JOB_ENABLED=1
CLEANEST_JOB_HORA=11:00
# Job vencimientos de cotizaciones (09:30 CDMX).
COTIZ_JOB_ENABLED=1
COTIZ_JOB_HORA=09:30
# Job cotizaciones facturadas sin vender (13:00 CDMX).
COTIZV_JOB_ENABLED=1
COTIZV_JOB_HORA=13:00
# Job alerta stock bajo Full (10:30 CDMX). IDs coma-separados, umbral en piezas.
MELI_FULL_ENABLED=1
MELI_FULL_HORA=10:30
MELI_FULL_IDS=MLM2167194978,MLM2168074994,MLM2167876444,MLM2686916323,MLM4558991504,MLM4559005490,MLM4558862636
MELI_FULL_UMBRAL=20
MELI_FULL_DRY_RUN=0
